# .env.example — split-hosting bridge
# The monolith is gone; there are two roles. Copy the block you need into `.env`
# (gitignored). Never commit real secrets.

# ─── Worker (devbox: runs Claude against real repos) ───
# Read by loadWorkerConfig(); the worker refuses to start if any required one is missing.
REPO_ROOT=C:\Users\you\Repos
DB_PATH=./sessions.db
RELAY_URL=wss://ca-tcb-adapter.mangopond-4a6e3187.eastus2.azurecontainerapps.io/relay
RELAY_SHARED_SECRET=          # ≥32 chars; MUST match the container's secret exactly

# ─── Container (Azure adapter: Teams ingress + relay server) ───
# Read by loadContainerConfig(). Keyless bot auth (UserAssignedMSI) — no password.
# botbuilder consumes the PascalCase names; keep these as the source of truth.
MicrosoftAppId=
MicrosoftAppType=UserAssignedMSI
MicrosoftAppTenantId=
ALLOWED_USERS=               # comma-separated UPNs and/or aadObjectId GUIDs; non-empty
PORT=3978
# RELAY_SHARED_SECRET also required here — same value as the worker.
